# Copy to .env and edit.  .env is gitignored — a real key never gets committed.
#
# NOTE: these are deliberately HARNESS_* and not ANTHROPIC_*. The anthropic SDK reads
# ANTHROPIC_BASE_URL / ANTHROPIC_API_KEY on its own, and those are often already set in a
# shell for some other reason — which would silently point this project at the wrong server.

# ---------------------------------------------------------------------------
# Option A (default): local models via Ollama.  Free, offline, no key needed.
#   Ollama v0.14+ speaks the Anthropic Messages API, so the anthropic SDK just works.
#
#   ollama serve
#   ollama pull qwen3-coder
# ---------------------------------------------------------------------------
HARNESS_BASE_URL=http://localhost:11434
HARNESS_API_KEY=ollama
HARNESS_MODEL=qwen3-coder

# The model MUST support tool calling or stages 2+ silently do nothing.
# Known-good: qwen3-coder, qwen2.5, llama3.1, mistral-nemo
# `uv run stages/s00_hello.py` checks this for you.

# ---------------------------------------------------------------------------
# Option B: the hosted Anthropic API. Comment out Option A and uncomment these.
#   Key from https://console.anthropic.com/settings/keys
#   The code does not change at all — that's the point.
# ---------------------------------------------------------------------------
# HARNESS_BASE_URL=https://api.anthropic.com
# HARNESS_API_KEY=sk-ant-...
# HARNESS_MODEL=claude-opus-5
# HARNESS_MAX_TOKENS=16000

# ---------------------------------------------------------------------------
# The plugin harness (dshpy/). Separate namespace again, same reasoning.
#   DS_PROVIDER picks which adapter claims ctx.llm -- and therefore which wire
#   protocol is spoken. Nothing else in the harness changes.
# ---------------------------------------------------------------------------
DS_PROVIDER=openai            # openai | anthropic
DS_MODEL=qwen3-coder
DS_API_KEY=ollama

# Leave blank to use the per-adapter default. Note the asymmetry:
#   openai    -> http://localhost:11434/v1   (OpenAI-compatible path is under /v1)
#   anthropic -> http://localhost:11434      (Anthropic-compatible path is at the root)
DS_BASE_URL=

# For DeepSeek's real API instead:
# DS_PROVIDER=openai
# DS_BASE_URL=https://api.deepseek.com/v1
# DS_API_KEY=sk-...
